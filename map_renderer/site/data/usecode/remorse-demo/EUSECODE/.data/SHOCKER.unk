    }
    FREE.slot_20(1);
    if (retval) {
      AudioProcess.playSFXCru(5, arg_06);
    }
    else {
      AudioProcess.playSFXCru(20, arg_06);
    }
    counter = 0;
    while (counter <= 5) {
      Item.legal_create(counter, arg_06);
      FREE.slot_20(pid, 5, 5);
      spawn FREE.waitNTimerTicks(retval, 0x00000000);
      suspend;
      counter = (1 + counter);
    }
    if (duration > 1) {
      Item.legal_create(6, arg_06);
      FREE.slot_33(0x020c, *(arg_06));
      Item.setQLo(5, arg_06);
      Item.setQLo(20, arg_06);
