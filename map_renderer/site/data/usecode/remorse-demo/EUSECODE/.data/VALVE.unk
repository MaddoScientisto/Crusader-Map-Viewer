/* ===== slot 0x01 use ===== */
function valve_use() /* entry=50 class_id=0x0030 slot=0x01 */
{
  var
    referent, /* [BP+00h] type=0x69 */
    counter, /* [BP-02h] type=0x69 */
    item; /* [BP-04h] type=0x24 */

  set_info(0x0207, *(arg_06));
  process_exclude();
  AudioProcess.playSFXCru(114, arg_06);
  if (Item.getFrame(arg_06) < 4) {
    counter = 0;
    while (counter <= 4) {
      Item.legal_create(counter, arg_06);
      spawn FREE.waitNTimerTicks(pid, 5, 0x00000000);
