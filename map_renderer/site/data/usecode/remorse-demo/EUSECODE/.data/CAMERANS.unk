/* ===== slot 0x0f enterFastArea ===== */
function camerans_enterFastArea() /* entry=442 class_id=0x01b8 slot=0x0f */
{
  var
    referent, /* [BP+00h] type=0x69 */
    delay, /* [BP-02h] type=0x69 */
    iSeeYou, /* [BP-04h] type=0x69 */
    trackedEnough, /* [BP-06h] type=0x69 */
    fram, /* [BP-08h] type=0x69 */
    counter, /* [BP-10h] type=0x69 */
    sawCrusader, /* [BP-12h] type=0x69 */
    movement, /* [BP-14h] type=0x69 */
    target, /* [BP-16h] type=0x24 */
    range, /* [BP-18h] type=0x69 */
    dir; /* [BP-20h] type=0x69 */

  entry:
    set_info(0x021b, *(arg_06));
    process_exclude();
    delay = ((5 - Game.getDifficultyLevel()) * 5);
    iSeeYou = (5 - (Game.getDifficultyLevel() * 5));
    if Item.getFrame(arg_06) != 9 goto block_0126;

  block_0120:
    goto block_04a7;

  while (!Item.isOnScreen(arg_06)) {
    spawn FREE.waitNTimerTicks(pid, delay, 0x00000000);
    suspend;
  }

  block_0162:
    sawCrusader = 0;
    movement = 1;

  while (true) {
    suspend;
    range = 0;
    while (!Item.isOnScreen(arg_06)) {
      spawn FREE.waitNTimerTicks(pid, delay, 0x00000000);
      suspend;
    }
    spawn FREE.waitNTimerTicks(pid, delay, 0x00000000);
    suspend;
    if (getTargetNPCNumMaybe() != 0) {
      target = getTargetNPCNumMaybe();
    }
    else {
      target = 1;
    }
    dir = getClosestDirectionInRange(13, 3, 16, Item.getY(target), Item.getX(target), Item.getY(arg_06), Item.getX(arg_06));
    fram = Item.getFrame(arg_06);
    if ((12 - dir) == fram) {
      range = Item.IsOn(target, arg_06);
      if (range) {
        sawCrusader = 1;
        trackedEnough = (1 + trackedEnough);
        if ((trackedEnough > iSeeYou) && (!(Item.getStatus(arg_06) & 0x1000))) {
          AudioProcess.playSFXCru(0x00e6, arg_06);
          spawn FREE.waitNTimerTicks(pid, delay, 0x00000000);
          suspend;
          spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
          suspend;
          ITEM.slot_23(0x1000, arg_06);
        }
      }
      else {
        sawCrusader = 0;
        if ((fram + movement) < 0) {
          movement = 1;
          spawn FREE.waitNTimerTicks(pid, 30, 0x00000000);
          suspend;
        }
        else if ((fram + movement) > 8) {
          movement = -1;
          spawn FREE.waitNTimerTicks(pid, 30, 0x00000000);
          suspend;
        }
        Item.setFrame((fram + movement), arg_06);
        Item.getQHi(0x00b5, arg_06);
      }
    }
    else if (trackedEnough && sawCrusader) {
      if ((12 - dir) > fram) {
        movement = 1;
      }
      else {
        movement = -1;
      }
    }
    else {
      trackedEnough = 0;
      sawCrusader = 0;
      Item.getDirFromTo16((~0x1000), arg_06);
    }
    if ((fram + movement) < 0) {
      movement = 1;
      spawn FREE.waitNTimerTicks(pid, 30, 0x00000000);
      suspend;
    }
    else if ((fram + movement) > 8) {
      movement = -1;
      spawn FREE.waitNTimerTicks(pid, 30, 0x00000000);
      suspend;
    }
    Item.setFrame((fram + movement), arg_06);
    Item.getQHi(0x00b5, arg_06);
  }

  return;


  /* post-return metadata (not executable):
