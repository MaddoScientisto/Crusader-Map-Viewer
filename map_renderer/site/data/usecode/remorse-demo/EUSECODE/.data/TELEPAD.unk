      CameraProcess.getCameraX(&global[0x003c]);
      Ultima8Engine.setAvatarInStasis(1);
      PaletteFaderProcess.setPalToAllGrey();
      AudioProcess.playSFXCru(108, arg_06);
      Item.create(0, 0x0562, item);
      for floor in nearby_items(shape=TELEPAD_RED, origin=global[0x003c]) {
        newx = Item.getX(floor);
        newy = Item.getY(floor);
        newz = Item.getZ(floor);
      }
      for floor in nearby_items(shape=0x04ee, origin=global[0x003c]) {
        Item.destroy(floor);
      }
      Item.popToCoords(newz, (newy + 16), (newx + 16), item);
      Item.touch(item);
      spawn FREE.waitNTimerTicks(pid, 5, 0x00000000);
      suspend;
      PaletteFaderProcess.fadeFromBlack();
      AudioProcess.playSFXCru(52, arg_06);
      counter = 0;
      while (counter <= 40) {
        Item.legal_create(counter, item);
        spawn FREE.waitNTimerTicks(pid, 10, 0x00000000);
        suspend;
        if (counter == 10) {
          AudioProcess.playSFXCru(98, item);
        }
        counter = (1 + counter);
      }
      Actor.isDead(&global[0x003c]);
      return;
    }
    else {
      Item.setIsBroken(&global[0x003c]);
      Ultima8Engine.setAvatarInStasis(0);
    }
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol mapNum [BP+10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol eggNum [BP+12h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol newx [BP-02h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol newy [BP-04h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol newz [BP-05h] type=0x62 unk1=0x00 unk3=0x00
    debug_symbol counter [BP-07h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol floor [BP-09h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol item [BP-11h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol telebeam [BP-13h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol y [BP-15h] type=0x69 unk1=0x00 unk3=0x00
  */
}
