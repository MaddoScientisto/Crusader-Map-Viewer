/* ===== slot 0x0f enterFastArea ===== */
function ebridge_enterFastArea() /* entry=936 class_id=0x03a6 slot=0x0f */
{
  var
    referent, /* [BP+00h] type=0x69 */
    x, /* [BP-02h] type=0x69 */
    y; /* [BP-04h] type=0x69 */

  set_info(0x021b, *(arg_06));
  process_exclude();
  AudioProcess.playAmbientSFXCru(92, arg_06);
  x = Item.setNpcNum(arg_06);
  if (x == 0) {
    return;
  }
  else {
    y = Actor.clrInCombat(arg_06);
    if ((y < 1) || (y > 127)) {
      return;
    }
    else {
      spawn BRIDGE.slot_26(pid, y, x, arg_06);
      suspend;
    }
  }
  return;

  /* post-return metadata (not executable):
