      playFlic(pid, 0x0096, 0x00c8, "2e", arg_06);
      suspend;
      break;
    case 8:
      playFlic(pid, 0x0096, 0x00c8, "8b", arg_06);
      suspend;
      break;
    case 12:
      playFlic(pid, 0x0096, 0x00c8, "12b", arg_06);
