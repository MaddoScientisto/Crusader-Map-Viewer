/* ===== slot 0x05 hit ===== */
function blaserew_hit() /* entry=710 class_id=0x02c4 slot=0x05 */
{
  set_info(0x020b, *(arg_06));
  process_exclude();
  spawn BLASER.slot_21(pid, arg_12, arg_10, arg_06);
  suspend;
  return;
}

/* ===== slot 0x06 gotHit ===== */
function blaserew_gotHit() /* entry=710 class_id=0x02c4 slot=0x06 */
{
