/* ===== slot 0x0a equip ===== */
function blaserew_equip() /* entry=710 class_id=0x02c4 slot=0x0a */
{
  set_info(0x0211, *(arg_06));
  process_exclude();
  if (arg_10 == 1) {
    local_02 = Item.getQHi(arg_06);
    Item.setQHi((local_02 | 4), arg_06);
    return;
  }
  else if (arg_10 == 31) {
    local_02 = Item.getQHi(arg_06);
    Item.setQHi((local_02 | 8), arg_06);
    return;
  }
  return;
}

/* ===== slot 0x0b unequip ===== */
function blaserew_unequip() /* entry=710 class_id=0x02c4 slot=0x0b */
{
  set_info(0x0212, *(arg_06));
  process_exclude();
  if ((Item.getStatus(arg_06) & 0x1000) == 0) {
    AudioProcess.playSFXCru(2, arg_06);
    spawn BLASER.slot_20(*(arg_06), arg_06);
  }
  return;
}

/* ===== slot 0x0f enterFastArea ===== */
function blaserew_enterFastArea() /* entry=710 class_id=0x02c4 slot=0x0f */
{
  set_info(0x021b, *(arg_06));
  process_exclude();
  if ((Item.getStatus(arg_06) & 0x1000) == 0) {
    spawn BLASER.slot_20(*(arg_06), arg_06);
  }
  return;
}

/* ===== slot 0x10 leaveFastArea ===== */
function blaserew_leaveFastArea() /* entry=710 class_id=0x02c4 slot=0x10 */
{
  set_info(0x021c, *(arg_06));
  process_exclude();
  Item.andStatus((~0x1000), arg_06);
  return;
}
