    spawn TRIGGER.slot_2a(pid, 0, *(arg_06), arg_06);
    suspend;
    Ultima8Engine.setAvatarInStasis(0);
    spawn FREE.waitNTimerTicks(pid, 0x00b4, 0x00000000);
