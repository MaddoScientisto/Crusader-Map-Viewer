  ITEM.slot_23(0x1000, arg_06);
  if (Actor.getMap(&global[0x003d]) == 21) {
    Ultima8Engine.setAvatarInStasis(1);
    suspend;
    Item.getPoint(0x00c8, "mva11b", arg_06);
    suspend;
    spawn FREE.waitNTimerTicks(pid, 20, 0x00000000);
