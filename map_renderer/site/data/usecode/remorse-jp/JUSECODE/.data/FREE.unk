        if (UCMachine.rndRange(100, 0) > 50) {
          Item.getFamilyOfType(0x00d4);
        }
        else {
          Item.getFamilyOfType(0x00d0);
        }
        for item in nearby_items(shape=0x0561, origin=ref) {
          if (Intrinsic02F(item)) {
            suspend;
          }
        }
      }
    }
  }
  return;

