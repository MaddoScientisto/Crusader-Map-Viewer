}

/* ===== slot 0x3c slot_3c ===== */
function free_slot_3c() /* entry=2575 class_id=0x0a0d slot=0x3c */
{
  var
    item, /* [BP-02h] type=0x24 */
    ref, /* [BP-04h] type=0x69 */
    rndVoice; /* [BP-06h] type=0x69 */

  set_info(1, 0);
  FREE.slot_33(0x022b, 0);
  ref = 1;
  MainActor.addItemCru();
  if (Actor.getLastAnimSet() == 1) {
    MainActor.addItemCru();
    return;
  }
  else {
    rndVoice = UCMachine.rndRange(100, 0);
    if (rndVoice < 30) {
      spawn FREE.slot_21(pid, 15, 0x00000000);
      suspend;
      rndVoice = UCMachine.rndRange(100, 0);
      if (rndVoice < 50) {
        spawn FREE.slot_21(pid, 14, 0x00000000);
        suspend;
      }
      MainActor.addItemCru();
      return;
    }
    else if (rndVoice > 60) {
      spawn FREE.slot_21(pid, 14, 0x00000000);
      suspend;
      rndVoice = UCMachine.rndRange(100, 0);
      if (rndVoice < 30) {
        spawn FREE.slot_21(pid, 15, 0x00000000);
        suspend;
      }
      if (rndVoice > 60) {
        spawn FREE.slot_21(pid, 0x00b6, 0x00000000);
        suspend;
      }
      MainActor.addItemCru();
      return;
    }
    else {
      spawn FREE.slot_21(pid, 0x00d2, 0x00000000);
      suspend;
      rndVoice = UCMachine.rndRange(100, 0);
      if (rndVoice < 30) {
        spawn FREE.slot_21(pid, 14, 0x00000000);
        suspend;
      }
      if (rndVoice > 60) {
        spawn FREE.slot_21(pid, 0x00b6, 0x00000000);
        suspend;
      }
      MainActor.addItemCru();
    }
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol item [BP-02h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol ref [BP-04h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol rndVoice [BP-06h] type=0x69 unk1=0x00 unk3=0x00
  */
}

