/* ===== slot 0x2a slot_2a ===== */
function trigger_slot_2a() /* entry=2589 class_id=0x0a1b slot=0x2a */
{
  var
    referent, /* [BP+00h] type=0x69 */
    ref, /* [BP+10h] type=0x69 */
    qHi, /* [BP+12h] type=0x69 */
    npcNum, /* [BP+14h] type=0x69 */
    mapNum, /* [BP+16h] type=0x69 */
    baseLink, /* [BP+18h] type=0x69 */
    searchtype, /* [BP+20h] type=0x69 */
    scmd, /* [BP-02h] type=0x69 */
    cmd, /* [BP-04h] type=0x69 */
    a, /* [BP-06h] type=0x69 */
    b, /* [BP-08h] type=0x69 */
    c, /* [BP-10h] type=0x69 */
    d, /* [BP-12h] type=0x69 */
    aitem, /* [BP-14h] type=0x24 */
    npc, /* [BP-16h] type=0x24 */
    counter, /* [BP-18h] type=0x69 */
    k; /* [BP-20h] type=0x69 */

  set_info(0x021b, 0);
  aitem = ref;
  cmd = (mapNum & 3);
  switch (cmd) {
  case 0:
    for npc in nearby_items(shape=searchtype, origin=aitem) {
      a = (qHi / 16);
      b = (qHi & 15);
      if (a == 0) {
        Item.andStatus(1, npc);
        suspend;
        spawn FREE.slot_32(pid, 2, 0x00000000);
        suspend;
        Item.andStatus(GetQOfAvatarInventoryItem0x4ed_0EB(npc), npc);
      }
      else {
        Item.andStatus(1, npc);
        suspend;
        spawn FREE.slot_32(pid, 2, 0x00000000);
        suspend;
        if (Item.setQAndCombine(npc) == 1) {
          return;
        }
        counter = 1;
        while (counter <= a) {
          if (Item.setQAndCombine(npc) == 0) {
            suspend;
          }
          spawn FREE.slot_32(pid, 1, 0x00000000);
          suspend;
          counter = (1 + counter);
        }
        Item.andStatus(GetQOfAvatarInventoryItem0x4ed_0EB(npc), npc);
      }
    }
    return;
  case 1:
    for npc in nearby_items(shape=searchtype, origin=aitem) {
      Item.getNPCNum(qHi, npc);
    }
    return;
  case 2:
    /* filter-only scan: npc in nearby_items(shape=searchtype, origin=aitem) */
    return;
  case 3:
    scmd = (qHi & 7);
    a = (qHi / 8);
    switch (scmd) {
    case 0:
      for npc in nearby_items(shape=searchtype, origin=aitem) {
        if (a == 1) {
          Item.andStatus(9, npc);
        }
        else if (a == 2) {
          Item.andStatus(10, npc);
        }
        else if (a == 3) {
          Item.andStatus(11, npc);
        }
        else {
          Item.andStatus(5, npc);
        }
      }
      break;
    case 1:
      for npc in nearby_items(shape=searchtype, origin=aitem) {
        Actor.setActivity(a, npc);
        spawn FREE.slot_32(pid, 1, 0x00000000);
        suspend;
        Item.andStatus(112, npc);
      }
      break;
    case 2:
      for npc in nearby_items(shape=searchtype, origin=aitem) {
        Intrinsic056(a, npc);
        spawn FREE.slot_32(pid, 1, 0x00000000);
        suspend;
        Item.andStatus(113, npc);
      }
      break;
    case 3:
      for npc in nearby_items(shape=searchtype, origin=aitem) {
        Item.getSurfaceWeight(a, npc);
        spawn FREE.slot_32(pid, 1, 0x00000000);
        suspend;
        Item.andStatus(114, npc);
      }
      break;
    case 4:
      for npc in nearby_items(shape=searchtype, origin=aitem) {
        k = a;
        Item.andStatus(k, npc);
      }
      break;
    case 5:
      for npc in nearby_items(shape=searchtype, origin=aitem) {
        spawn NPC.equip(a, npc);
      }
      break;
    }
    return;
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol ref [BP+10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol qHi [BP+12h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol npcNum [BP+14h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol mapNum [BP+16h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol baseLink [BP+18h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol searchtype [BP+20h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol scmd [BP-02h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol cmd [BP-04h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol a [BP-06h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol b [BP-08h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol c [BP-10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol d [BP-12h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol aitem [BP-14h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol npc [BP-16h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol counter [BP-18h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol k [BP-20h] type=0x69 unk1=0x00 unk3=0x00
  */
}

