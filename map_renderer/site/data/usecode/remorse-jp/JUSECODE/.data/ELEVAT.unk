    checkY = retval;
    if ((checkX < 2) && (checkY < 2)) {
      if ((Item.getStatus(liftpit) & 0x1000) == 0) {
        Item.orStatus(0x1000, liftpit);
        if (Item.getFrame(liftpit) == 0) {
          pitCounter = 1;
          while (pitCounter <= totFrames) {
            spawn FREE.slot_32(pid, 1, 0x00000000);
            suspend;
            Item.getPoint(pitCounter, liftpit);
            pitCounter = (1 + pitCounter);
          }
        }
        else {
          pitCounter = totFrames;
          while (pitCounter > 0) {
            spawn FREE.slot_32(pid, 1, 0x00000000);
            suspend;
            Item.getPoint(pitCounter, liftpit);
            pitCounter = (pitCounter - 1);
          }
          spawn FREE.slot_32(pid, 2, 0x00000000);
          suspend;
          Item.getPoint(0, liftpit);
        }
        Ultima8Engine.getUnkCrusaderFlag((~0x1000), liftpit);
      }
    }
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol liftpit [BP-02h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol pitCounter [BP-03h] type=0x62 unk1=0x00 unk3=0x00
    debug_symbol totFrames [BP-04h] type=0x62 unk1=0x00 unk3=0x00
    debug_symbol checkX [BP-06h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol checkY [BP-08h] type=0x69 unk1=0x00 unk3=0x00
  */
}
