        }
      }
      else if (Item.andStatus(arg_06) == 0x00fd) {
        spawn FREE.slot_32(pid, 60, 0x00000000);
        suspend;
        playFlic(pid, 0x0096, 0x00c8, "3j", arg_06);
        suspend;
      }
      else if (Item.andStatus(arg_06) > 0x00f9) {
        MusicProcess.musicStop();
        Actor.setDead();
        Item.getRangeIfVisible(Actor.getMap(&global[0x003c]), Item.getZ(cameraEgg), Item.getY(cameraEgg), Item.getX(cameraEgg));
        spawn FREE.slot_32(pid, 10, 0x00000000);
        suspend;
        spawn SURCAMEW.slot_22(cameraEgg, arg_06);
      }
      else {
        MusicProcess.musicStop();
        x = Item.getX(cameraEgg);
        y = Item.getY(cameraEgg);
        z = Item.getZ(cameraEgg);
        Actor.setDead();
        Item.getRangeIfVisible(Actor.getMap(&global[0x003c]), z, y, x);
        spawn FREE.slot_32(pid, 10, 0x00000000);
        suspend;
        resetVargasHealthTo500();
        spawn FREE.slot_32(pid, 60, 0x00000000);
        suspend;
        if (Item.getMapArray(cameraEgg) != 0) {
          spawn TRIGGER.slot_20(pid, 0, cameraEgg, arg_06);
          suspend;
        }
        spawn FREE.slot_32(pid, 120, 0x00000000);
        suspend;
        while (!MainActor.teleportToEgg()) {
          spawn FREE.slot_32(pid, 2, 0x00000000);
          suspend;
        }
        MusicProcess.musicStop();
        CameraProcess.somethingAboutCameraUpdate();
        Item.getRangeIfVisible(Item.getX(Item.getY(Item.getZ(Actor.getMap(&global[0x003c]), &global[0x003c]), &global[0x003c]), &global[0x003c]));
        spawn FREE.slot_32(pid, 10, 0x00000000);
        suspend;
        PaletteFaderProcess.fadeFromBlack();
      }
    }
  }
  spawn FREE.slot_32(pid, 30, 0x00000000);
  suspend;
  if (screen) {
    Item.destroy(screen);
  }
  Ultima8Engine.setAvatarInStasis(0);
  AudioProcess.stopSFX();
  Actor.setEquip();
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol screen [BP-02h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol cameraEgg [BP-04h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol trueRef [BP-06h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol npc [BP-08h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol therma [BP-10h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol x1 [BP-12h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol y1 [BP-14h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol z1 [BP-15h] type=0x62 unk1=0x00 unk3=0x00
    debug_symbol x [BP-17h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol y [BP-19h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol z [BP-20h] type=0x62 unk1=0x00 unk3=0x00
  */
}

/* ===== slot 0x22 slot_22 ===== */
function surcamew_slot_22() /* entry=1248 class_id=0x04de slot=0x22 */
{
  var
    referent, /* [BP+00h] type=0x69 */
    eventTrigger, /* [BP+10h] type=0x24 */
    n, /* [BP-02h] type=0x24 */
    foundGun; /* [BP-03h] type=0x62 */

  set_info(0x00f0, 0);
  for n in selector_0x42(arg0=0x04c8, arg1=0x01cd, arg2=(50 * 32), origin=eventTrigger) {
    if (Actor.isNPC(n)) {
      Item.setFrame(n);
      foundGun = 1;
    }
  }
  Item.getRangeIfVisible(Actor.getMap(&global[0x003c]), Item.getZ(eventTrigger), Item.getY(eventTrigger), Item.getX(eventTrigger));
  spawn FREE.slot_32(pid, 10, 0x00000000);
  suspend;
  resetVargasHealthTo500();
  if (foundGun) {
    while (getTargetNPCNumMaybe() != 1) {
      spawn FREE.slot_32(pid, 5, 0x00000000);
      suspend;
    }
  }
  else {
    spawn FREE.slot_32(pid, 0x00c8, 0x00000000);
    suspend;
  }
  MusicProcess.musicStop();
  Item.getRangeIfVisible(Item.getX(Item.getY(Item.getZ(Actor.getMap(&global[0x003c]), &global[0x003c]), &global[0x003c]), &global[0x003c]));
  CameraProcess.somethingAboutCameraUpdate();
  PaletteFaderProcess.fadeFromBlack();
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol eventTrigger [BP+10h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol n [BP-02h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol foundGun [BP-03h] type=0x62 unk1=0x00 unk3=0x00
  */
}
