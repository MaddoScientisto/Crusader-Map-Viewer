      suspend;
      return;
    }
    else {
      link = Item.unequip(hover);
      tx = -1;
      for item in nearby_items(shape=NUMBERS, origin=ref) {
        if (Item.getFrame(item) == targetEgg) {
          if ((link == 0) || (link == Item.unequip(item))) {
            tx = Item.getX(item);
            ty = Item.getY(item);
            tz = Item.getZ(item);
            time = Item.hurl(item);
          }
        }
      }
      if (tx == -1) {
        if (targetEgg == firstEgg) {
          Item.isOn((~0x1000), hover);
          Item.pop(oldqhi, hover);
          return;
        }
        targetEgg = firstEgg;
        h = (h & 0x00f0);
        Item.pop((h | targetEgg), hover);
      }
      spawn HOVER.slot_20(pid, tz, ty, tx, ref, arg_06);
      suspend;
      if (process_result == 1) {
        Item.pop(oldqhi, hover);
        return;
      }
      else {
        spawn HOVER.slot_24(pid, targetEgg, ref, arg_06);
        suspend;
        if ((Item.getStatus(hover) & 0x1000) == 0) {
          Item.pop(oldqhi, hover);
          spawn HOVER.slot_23(pid, 1, ref, arg_06);
          suspend;
          return;
        }
        else if (h & 0x0080) {
          spawn TRIGGER.slot_20(pid, (0 + 0x0080), item, arg_06);
          suspend;
        }
        if (time != 0) {
          spawn FREE.slot_32(pid, (time * 10), 0x00000000);
          suspend;
        }
        h = Item.hurl(hover);
        if ((h & 15) == targetEgg) {
          targetEgg = ((targetEgg + 1) & 15);
        }
        else {
          firstEgg = (h & 15);
          targetEgg = firstEgg;
          oldqhi = h;
        }
        h = (h & 0x00f0);
        Item.pop((h | targetEgg), hover);
      }
    }
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol ref [BP+10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol h [BP-02h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol firstEgg [BP-04h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol targetEgg [BP-06h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol time [BP-08h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol oldqhi [BP-10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol link [BP-12h] type=0x69 unk1=0x00 unk3=0x00
