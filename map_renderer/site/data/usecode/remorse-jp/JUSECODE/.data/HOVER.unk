/* ===== slot 0x23 slot_23 ===== */
function hover_slot_23() /* entry=2576 class_id=0x0a0e slot=0x23 */
{
  var
    referent, /* [BP+00h] type=0x69 */
    ref, /* [BP+10h] type=0x69 */
    check, /* [BP+12h] type=0x62 */
    cargo, /* [BP-02h] type=0x24 */
    item, /* [BP-04h] type=0x24 */
    hover, /* [BP-06h] type=0x24 */
    dx, /* [BP-08h] type=0x69 */
    dy, /* [BP-10h] type=0x69 */
    dz, /* [BP-12h] type=0x69 */
    firstEgg, /* [BP-14h] type=0x69 */
    link, /* [BP-16h] type=0x69 */
    x, /* [BP-18h] type=0x69 */
    y, /* [BP-20h] type=0x69 */
    z; /* [BP-21h] type=0x62 */

  set_info(1, 0);
  hover = ref;
  if ((check == 1) && (Intrinsic02F(hover) == 1)) {
    return;
  }
  else {
    firstEgg = (Item.hurl(hover) & 15);
    link = Item.unequip(hover);
    for item in nearby_items(shape=NUMBERS, origin=ref) {
      if (Item.getFrame(item) == firstEgg) {
        if ((link == 0) || (link == Item.unequip(item))) {
          x = Item.getX(item);
          y = Item.getY(item);
          z = Item.getZ(item);
          dx = (x - Item.getX(hover));
          dy = (y - Item.getY(hover));
          dz = (z - Item.getZ(hover));
          while (condition) {
            if (Item.getShape(cargo) != NUMBERS) {
              push(cargo);
              Item.popToCoords((Item.getZ(cargo) + dz), (Item.getY(cargo) + dy), (Item.getX(cargo) + dx), cargo);
            }
          }
          push(hover);
          Item.popToCoords(z, y, x, hover);
          return;
        }
      }
    }
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
