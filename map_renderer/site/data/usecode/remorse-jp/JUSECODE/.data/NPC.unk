    if ((retval == 0) && (Item.isOnScreen(arg_06) == 1)) {
      Actor.getSomeFlagProbablyCrouch(UCMachine.rndRange(7, (20 - (Game.getDifficultyLevel() * 2)), 5), dir, damageSource, arg_06);
    }
    spawn FREE.slot_32(pid, 2, 0x00000000);
    suspend;
    return;
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol damageSource [BP+10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol dir [BP+12h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol aSet [BP-02h] type=0x69 unk1=0x00 unk3=0x00
  */
}

