/* ===== slot 0x06 gotHit ===== */
function fffloor_gotHit() /* entry=311 class_id=0x0135 slot=0x06 */
{
  var
    referent, /* [BP+00h] type=0x69 */
    ref, /* [BP+10h] type=0x69 */
    vel, /* [BP+12h] type=0x69 */
    n; /* [BP-02h] type=0x24 */

  set_info(0x020c, *(arg_06));
  process_exclude();
  if ((Item.getFrame(arg_06) == 1) || (ref > 0x0100)) {
    return;
  }
  else {
    n = ref;
    while (getAnimationsDisabled(*(arg_06), n)) {
      if (Item.getFrame(arg_06) == 1) {
        return;
      }
      else {
        FREE.slot_20(pid, 8);
        spawn NPC.slot_2d(retval, *(arg_06), n);
        suspend;
        spawn FREE.slot_32(pid, 2, 0x00000000);
        suspend;
      }
    }
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol ref [BP+10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol vel [BP+12h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol n [BP-02h] type=0x24 unk1=0x00 unk3=0x02
  */
}

/* ===== slot 0x0a equip ===== */
function fffloor_equip() /* entry=311 class_id=0x0135 slot=0x0a */
{
  var
    referent, /* [BP+00h] type=0x69 */
    var, /* [BP+10h] type=0x69 */
    egg, /* [BP-02h] type=0x24 */
    fffloor; /* [BP-04h] type=0x24 */

  set_info(0x0211, *(arg_06));
  process_exclude();
  switch (var) {
  case 0:
    for egg in nearby_items(shape=17, origin=arg_06) {
      if (Egg.setEggXRange(egg) == 2) {
        Item.overlaps(0, egg);
      }
    }
    spawn FREE.slot_32(pid, 10, 0x00000000);
    suspend;
    Item.orStatus(0x1000, arg_06);
    return;
  case 1:
    for egg in nearby_items(shape=17, origin=arg_06) {
      if (Egg.setEggXRange(egg) == 2) {
        Item.overlaps(0, egg);
      }
    }
    PaletteFaderProcess.stopFadesAndResetToGamePal((~0x1000), arg_06);
    return;
  case 29:
    spawn FREE.slot_32(pid, 10, 0x00000000);
    suspend;
    for fffloor in nearby_items(shape=0x0135, origin=arg_06) {
      Item.getPoint(1, fffloor);
    }
    return;
  case 30:
    spawn FREE.slot_32(pid, 10, 0x00000000);
    suspend;
    for egg in nearby_items(shape=17, origin=arg_06) {
      if (Egg.setEggXRange(egg) == 2) {
        Item.overlaps(1, egg);
      }
    }
    spawn FREE.slot_32(pid, 5, 0x00000000);
    suspend;
    for fffloor in nearby_items(shape=0x0135, origin=arg_06) {
      Item.getPoint(0, fffloor);
      Item.touch(fffloor);
    }
    return;
  case 31:
    for egg in nearby_items(shape=17, origin=arg_06) {
      if (Egg.setEggXRange(egg) == 2) {
        Item.overlaps(1, egg);
      }
    }
    return;
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol var [BP+10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol egg [BP-02h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol fffloor [BP-04h] type=0x24 unk1=0x00 unk3=0x02
  */
}

/* ===== slot 0x0b unequip ===== */
function fffloor_unequip() /* entry=311 class_id=0x0135 slot=0x0b */
{
  var
    referent, /* [BP+00h] type=0x69 */
    var, /* [BP+10h] type=0x69 */
    item; /* [BP-02h] type=0x24 */

  set_info(0x0212, *(arg_06));
  process_exclude();
  if (Item.getFrame(arg_06) == 1) {
    return;
  }
  else {
    for item in nearby_items(family=6, origin=arg_06) {
      if (Actor.isNPC(item) == 1) {
        if (Item.isOn(item, arg_06)) {
          FREE.slot_20(pid, 8);
          spawn NPC.slot_2d(retval, *(arg_06), item);
          suspend;
        }
      }
    }
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol var [BP+10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol item [BP-02h] type=0x24 unk1=0x00 unk3=0x02
  */
}
