    else {
      for valueBox in nearby_items(shape=VALUEBOX, origin=arg_06) {
        if (Item.getQLo(valueBox) == link) {
          VALBOX.slot_20(valueBox);
          passcode = retval;
          boxCounter = (1 + boxCounter);
