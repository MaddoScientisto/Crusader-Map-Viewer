/* synthesized appendix for SKILLBOX */
/* sparse lines above preserve recovered debugger line numbers where available */

/* ===== slot 0x0a equip ===== */
function skillbox_equip() /* entry=1253 class_id=0x04e3 slot=0x0a */
{
  var
    referent, /* [BP+00h] type=0x69 */
    var, /* [BP+10h] type=0x69 */
    skill, /* [BP-02h] type=0x69 */
    qLo; /* [BP-04h] type=0x69 */

  set_info(0x0211, *(arg_06));
  process_exclude();
  skill = Game.getDifficultyLevel();
  if (Item.getMapArray(arg_06) != 0) {
    if (Item.getFrame(arg_06) == 2) {
      qLo = Item.getQLo(arg_06);
      if (skill == 1) {
        spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
        suspend;
      }
      else if (skill == 2) {
        Item.setQLo((qLo + 1), arg_06);
        spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
        suspend;
      }
      else if (skill >= 3) {
        Item.setQLo((qLo + 2), arg_06);
        spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
        suspend;
      }
      Item.setQLo(qLo, arg_06);
      return;
    }
    if (skill >= (Item.getFrame(arg_06) + 2)) {
      spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
      suspend;
    }
    else {
      spawn TRIGGER.slot_20(pid, 1, *(arg_06), arg_06);
      suspend;
    }
    return;
  }
  else if (skill >= (Item.getFrame(arg_06) + 2)) {
    spawn TRIGGER.slot_20(pid, (0 + 0x0080), *(arg_06), arg_06);
    suspend;
    return;
  }
  else {
    spawn TRIGGER.slot_20(pid, (1 + 0x0080), *(arg_06), arg_06);
    suspend;
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol var [BP+10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol skill [BP-02h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol qLo [BP-04h] type=0x69 unk1=0x00 unk3=0x00
  */
}
