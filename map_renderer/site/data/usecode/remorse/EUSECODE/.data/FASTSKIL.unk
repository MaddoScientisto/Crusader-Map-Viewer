function fastskil_enterFastArea() /* entry=290 class_id=0x0120 slot=0x0f */
{
  var
    referent, /* [BP+00h] type=0x69 */
    skill, /* [BP-02h] type=0x69 */
    qLo; /* [BP-04h] type=0x69 */

  set_info(0x021b, *(arg_06));
