        Item.setQLo((qLo + 1), arg_06);
        spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
        suspend;
      }
      else if (skill >= 3) {
        Item.setQLo((qLo + 2), arg_06);
        spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
        suspend;
      }
      Item.setQLo(qLo, arg_06);
