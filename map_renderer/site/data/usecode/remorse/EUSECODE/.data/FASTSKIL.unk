    }
    if (skill >= (Item.getFrame(arg_06) + 2)) {
      spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
      suspend;
    }
    else {
      spawn TRIGGER.slot_20(pid, 1, *(arg_06), arg_06);
      suspend;
