/* ===== slot 0x01 use ===== */
function vardesk_use() /* entry=1092 class_id=0x0442 slot=0x01 */
{
  var
    referent, /* [BP+00h] type=0x69 */
    item, /* [BP-02h] type=0x24 */
    counter; /* [BP-04h] type=0x69 */

  set_info(0x0207, *(arg_06));
  process_exclude();
  Ultima8Engine.setAvatarInStasis(1);
  FREE.slot_33(0x021b, *(arg_06));
  while (Item.getFrame(arg_06) < 4) {
    Item.setFrame((Item.getFrame(arg_06) + 1), arg_06);
    spawn FREE.waitNTimerTicks(pid, 5, 0x00000000);
    suspend;
  }
  spawn FREE.waitNTimerTicks(pid, 5, 0x00000000);
  suspend;
  if (global[0x001f] == 9) {
    playFlic(pid, 0x0096, 0x00c8, "9d", arg_06);
    suspend;
  }
  else if (global[0x001f] == 10) {
    playFlic(pid, 0x0096, 0x00c8, "10d", arg_06);
    suspend;
  }
  else if (global[0x001f] == 11) {
    playFlic(pid, 0x0096, 0x00c8, "11e", arg_06);
    suspend;
  }
  else if (global[0x001f] == 12) {
    playFlic(pid, 0x0096, 0x00c8, "12d", arg_06);
    suspend;
  }
  else if (global[0x001f] == 13) {
    playFlic(pid, 0x0096, 0x00c8, "13c", arg_06);
    suspend;
  }
  else {
    playFlic(pid, 0x0096, 0x00c8, "10d", arg_06);
    suspend;
  }
  for item in nearby_items(shape=0x043d, origin=arg_06) {
    Item.setQLo(global[0x001f], item);
    Item.setFrame(1, item);
  }
  counter = 0;
  while (counter <= 4) {
    Item.setFrame((4 - counter), arg_06);
    spawn FREE.waitNTimerTicks(pid, 10, 0x00000000);
    suspend;
    counter = (1 + counter);
  }
  spawn VARDESK.enterFastArea(arg_06);
  Ultima8Engine.setAvatarInStasis(0);
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol item [BP-02h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol counter [BP-04h] type=0x69 unk1=0x00 unk3=0x00
  */
}

/* ===== slot 0x0f enterFastArea ===== */
function vardesk_enterFastArea() /* entry=1092 class_id=0x0442 slot=0x0f */
{
  var
    referent, /* [BP+00h] type=0x69 */
    counter, /* [BP-02h] type=0x69 */
    ran; /* [BP-04h] type=0x69 */

  set_info(0x021b, *(arg_06));
  process_exclude();
  if (Item.getFrame(arg_06) == 6) {
    return;
  }
  else {
    suspend;
    FREE.slot_20(pid, 100);
    spawn FREE.waitNTimerTicks((retval + 60), 0x00000000);
    suspend;
    while (true) {
      suspend;
      FREE.slot_20(pid, 100);
      spawn FREE.waitNTimerTicks((retval + 60), 0x00000000);
      suspend;
      if (!Item.getFrame(arg_06)) {
        counter = 0;
        while (counter <= 4) {
          Item.setFrame(counter, arg_06);
          spawn FREE.waitNTimerTicks(pid, 10, 0x00000000);
          suspend;
          counter = (1 + counter);
        }
      }
      FREE.slot_20(100);
      if (retval > 50) {
        counter = 0;
        while (counter <= 4) {
          Item.setFrame((4 - counter), arg_06);
          spawn FREE.waitNTimerTicks(pid, 10, 0x00000000);
          suspend;
          counter = (1 + counter);
        }
      }
      else {
        FREE.slot_20(3);
        ran = (retval + 3);
        counter = 0;
        while (counter <= ran) {
          Item.setFrame(5, arg_06);
          spawn FREE.waitNTimerTicks(pid, 10, 0x00000000);
          suspend;
          Item.setFrame(4, arg_06);
          spawn FREE.waitNTimerTicks(pid, 10, 0x00000000);
          suspend;
          counter = (1 + counter);
        }
      }
    }
  }
  return;

  /* post-return metadata (not executable):
