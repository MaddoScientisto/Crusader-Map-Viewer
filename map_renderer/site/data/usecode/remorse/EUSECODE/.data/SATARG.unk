/* synthesized appendix for SATARG */
/* sparse lines above preserve recovered debugger line numbers where available */

/* ===== slot 0x01 use ===== */
function satarg_use() /* entry=1355 class_id=0x0549 slot=0x01 */
{
  var
    referent, /* [BP+00h] type=0x69 */
    item, /* [BP-02h] type=0x24 */
    counter; /* [BP-04h] type=0x69 */

  set_info(0x0207, *(arg_06));
  process_exclude();
  if (Item.getFrame(arg_06)) {
    return;
  }
  else {
    Ultima8Engine.setAvatarInStasis(1);
    while (Actor.isBusy(&global[0x003c])) {
      spawn FREE.waitNTimerTicks(pid, 2, 0x00000000);
      suspend;
    }
    suspend;
    spawn FREE.waitNTimerTicks(pid, 30, 0x00000000);
    suspend;
    AudioProcess.playSFXCru(0x0093, arg_06);
    spawn FREE.waitNTimerTicks(pid, 60, 0x00000000);
    suspend;
    playFlicsomething(0x00c8, "mva15b", arg_06);
    suspend;
    spawn FREE.waitNTimerTicks(pid, 60, 0x00000000);
    suspend;
    spawn ITEM.slot_28(pid, 0, 1, arg_06);
    suspend;
    Item.setFrame(1, arg_06);
    spawn FREE.slot_3b(0x00000000);
    Ultima8Engine.setAvatarInStasis(0);
    for item in nearby_items(shape=NUMBERS, origin=arg_06) {
      if (Item.getQLo(item) == 0) {
        Item.explode(0, 0, item);
        spawn FREE.waitNTimerTicks(UCMachine.rndRange(pid, 30, 20), 0x00000000);
        suspend;
      }
    }
    for item in nearby_items(shape=GENERATR, origin=arg_06) {
      spawn ITEM.slot_28(pid, 0, 1, item);
      suspend;
      if (Item.getFrame(item) < 2) {
        Item.setFrame(UCMachine.rndRange(4, 2), item);
      }
      spawn FREE.waitNTimerTicks(UCMachine.rndRange(pid, 40, 20), 0x00000000);
      suspend;
    }
    for item in nearby_items(shape=0x03bf, origin=arg_06) {
      spawn ITEM.slot_28(pid, 0, 1, item);
      suspend;
      if (Item.getFrame(item) < 4) {
        Item.setFrame((Item.getFrame(item) + 4), item);
      }
      spawn FREE.waitNTimerTicks(UCMachine.rndRange(pid, 50, 30), 0x00000000);
      suspend;
    }
    spawn FREE.waitNTimerTicks(pid, 0x00c8, 0x00000000);
    suspend;
    spawn FREE.slot_26(pid, "15d", 0x00000000);
    suspend;
    spawn FREE.waitNTimerTicks(pid, 0x00c8, 0x00000000);
    suspend;
    spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
    suspend;
    spawn FREE.waitNTimerTicks(pid, 0x00c8, 0x00000000);
    suspend;
    if (Game.getDifficultyLevel() > 1) {
      spawn TRIGGER.slot_20(pid, 1, *(arg_06), arg_06);
      suspend;
    }
    spawn FREE.waitNTimerTicks(pid, 0x00c8, 0x00000000);
    suspend;
    for item in nearby_items(shape=TELEPORTER_LIGHTS, origin=arg_06) {
      if (Item.getQLo(item) == 0x00ff) {
        Item.setFrame(0, item);
        Item.setQLo(23, item);
      }
    }
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol item [BP-02h] type=0x24 unk1=0x00 unk3=0x02
    debug_symbol counter [BP-04h] type=0x69 unk1=0x00 unk3=0x00
  */
}
