/* ===== slot 0x06 gotHit ===== */
function windsurf_gotHit() /* entry=825 class_id=0x0337 slot=0x06 */
{
  var
    referent, /* [BP+00h] type=0x69 */
    ref, /* [BP+10h] type=0x69 */
    vel, /* [BP+12h] type=0x69 */
    item, /* [BP-02h] type=0x24 */
    xoff, /* [BP-04h] type=0x69 */
    yoff, /* [BP-06h] type=0x69 */
    speed, /* [BP-08h] type=0x69 */
    dir, /* [BP-10h] type=0x69 */
    wp, /* [BP-15h] type=0x24 */
    param; /* [BP-17h] type=0x69 */

  set_info(0x020c, *(arg_06));
  process_exclude();
  FREE.slot_2c(vel, ref);
  if (retval) {
    return;
  }
  else if (Item.getMapArray(arg_06) == 0) {
    item = ref;
    if (Item.getTypeFlag(0, item)) {
      return;
    }
    if (Item.getShape(item) == 0x01d9) {
      return;
    }
    if (Item.overlaps(ref, arg_06) == 0) {
      return;
    }
    if (Item.getQHi(arg_06) == 0x00ff) {
      return;
    }
    if (Item.getZ(arg_06) == 0x00fe) {
      return;
    }
    if (Item.getNPCNum(arg_06) == 0x00ff) {
      if (!Actor.isNPC(item)) {
        Item.destroy(item);
      }
      return;
    }
    xoff = 0;
    yoff = 0;
    param = Item.getQHi(arg_06);
    dir = (param & 15);
    speed = ((param / 16) & 15);
    if (speed == 0) {
      speed = 3;
    }
    else if (speed == 15) {
      speed = (3 + (Game.getDifficultyLevel() * 2));
    }
    switch (dir) {
    case 0:
      yoff = -1;
      break;
    case 1:
      yoff = -2;
      xoff = 1;
      break;
    case 2:
      yoff = -1;
      xoff = 1;
      break;
    case 3:
      yoff = -1;
      xoff = 2;
      break;
    case 4:
      xoff = 1;
      break;
    case 5:
      xoff = 2;
      yoff = 1;
      break;
    case 6:
      xoff = 1;
      yoff = 1;
      break;
    case 7:
      xoff = 1;
      yoff = 2;
      break;
    case 8:
      yoff = 1;
      break;
    case 9:
      yoff = 2;
      xoff = -1;
      break;
    case 10:
      yoff = 1;
      xoff = -1;
      break;
    case 11:
      yoff = 1;
      xoff = -2;
      break;
    case 12:
      xoff = -1;
      break;
    case 13:
      xoff = -2;
      yoff = -1;
      break;
    case 14:
      xoff = -1;
      yoff = -1;
      break;
    case 15:
      xoff = -1;
      yoff = -2;
      break;
    }
    xoff = (xoff * speed);
    yoff = (yoff * speed);
    spawn FREE.waitNTimerTicks(pid, 2, 0x00000000);
    suspend;
    while (1) {
      wp = (Item.getX(item) + xoff);
      local_13 = (Item.getY(item) + yoff);
      local_11 = Item.getZ(item);
      legalMoveToPoint(0, 1, wp, item);
      spawn FREE.waitNTimerTicks(pid, 5, 0x00000000);
      suspend;
      if (Item.overlaps(ref, arg_06) == 0) {
      }
    }
    if (Item.getZ(item) > 1) {
      suspend;
    }
    return;
  }
  else {
    spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
    suspend;
  }
  return;

