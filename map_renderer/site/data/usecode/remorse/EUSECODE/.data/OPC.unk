/* ===== slot 0x01 use ===== */
function opc_use() /* entry=958 class_id=0x03bc slot=0x01 */
{
  var
    referent, /* [BP+00h] type=0x69 */
    item; /* [BP-02h] type=0x24 */

  set_info(0x0207, *(arg_06));
  process_exclude();
  ITEM.slot_23(0x1000, arg_06);
  if (Actor.getMap(&global[0x003c]) == 21) {
    Ultima8Engine.setAvatarInStasis(1);
    suspend;
    playFlicsomething(0x00c8, "mva11b", arg_06);
    suspend;
    spawn FREE.waitNTimerTicks(pid, 20, 0x00000000);
    suspend;
    spawn TRIGGER.slot_20(pid, 0, *(arg_06), arg_06);
    suspend;
    Ultima8Engine.setAvatarInStasis(0);
    spawn FREE.waitNTimerTicks(pid, 0x00b4, 0x00000000);
