      spawn FREE.slot_26(pid, "11g", 0x00000000);
      suspend;
    }
    for item in nearby_items(shape=TELEPORTER_LIGHTS, origin=arg_06) {
      if (Item.getQLo(item) == 99) {
        Item.setQLo(30, item);
        Item.setFrame(0, item);
      }
