/* ===== slot 0x06 gotHit ===== */
function fffloor2_gotHit() /* entry=458 class_id=0x01c8 slot=0x06 */
{
  var
    referent, /* [BP+00h] type=0x69 */
    ref, /* [BP+10h] type=0x69 */
    vel, /* [BP+12h] type=0x69 */
    n; /* [BP-02h] type=0x24 */

  set_info(0x020c, *(arg_06));
  process_exclude();
  if ((Item.getFrame(arg_06) == 1) || (ref > 0x0100)) {
    return;
  }
  else {
    n = ref;
    while (Item.isOn(*(arg_06), n)) {
      if (Item.getFrame(arg_06) == 1) {
        return;
      }
      else {
        FREE.slot_20(pid, 8);
        spawn NPC.slot_2d(retval, *(arg_06), n);
        suspend;
        spawn FREE.waitNTimerTicks(pid, 2, 0x00000000);
        suspend;
      }
    }
  }
  return;

  /* post-return metadata (not executable):
    debug_symbol referent [BP+00h] type=0x69 unk1=0x01 unk3=0x00
    debug_symbol ref [BP+10h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol vel [BP+12h] type=0x69 unk1=0x00 unk3=0x00
    debug_symbol n [BP-02h] type=0x24 unk1=0x00 unk3=0x02
  */
}

/* ===== slot 0x0a equip ===== */
function fffloor2_equip() /* entry=458 class_id=0x01c8 slot=0x0a */
{
  var
    referent, /* [BP+00h] type=0x69 */
    var, /* [BP+10h] type=0x69 */
    egg, /* [BP-02h] type=0x24 */
    fffloor; /* [BP-04h] type=0x24 */

  set_info(0x0211, *(arg_06));
  process_exclude();
  switch (var) {
  case 0:
    for egg in nearby_items(shape=17, origin=arg_06) {
      if (Item.getUnkEggType(egg) == 2) {
        Egg.setEggXRange(0, egg);
      }
    }
    Item.orStatus(0x1000, arg_06);
    return;
  case 1:
    for egg in nearby_items(shape=17, origin=arg_06) {
      if (Item.getUnkEggType(egg) == 2) {
        Egg.setEggXRange(0, egg);
      }
    }
    Item.andStatus((~0x1000), arg_06);
    return;
  case 29:
    spawn FREE.waitNTimerTicks(pid, 10, 0x00000000);
    suspend;
    for fffloor in nearby_items(shape=0x0135, origin=arg_06) {
      Item.setFrame(1, fffloor);
    }
    return;
  case 30:
    Item.orStatus(0x1000, arg_06);
    spawn FREE.waitNTimerTicks(pid, 10, 0x00000000);
    suspend;
    for egg in nearby_items(shape=17, origin=arg_06) {
      if (Item.getUnkEggType(egg) == 2) {
        Egg.setEggXRange(1, egg);
      }
    }
    spawn FREE.waitNTimerTicks(pid, 10, 0x00000000);
    suspend;
    for fffloor in nearby_items(shape=WHITE_GRID, origin=arg_06) {
      Item.setFrame(0, fffloor);
    }
    return;
  case 31:
    for egg in nearby_items(shape=17, origin=arg_06) {
      if (Item.getUnkEggType(egg) == 2) {
        Egg.setEggXRange(1, egg);
      }
    }
    return;
  }
  return;

  /* post-return metadata (not executable):
