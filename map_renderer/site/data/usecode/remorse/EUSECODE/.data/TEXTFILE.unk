    textFile = "Security Cartel:^__________________^Remote Operations^Watch Station: ^*<NOW ACTIVE>";
  }
  else if (msgNum == 18) {
    textFile = (("From: DBEYER^______________^Due to the alert, I have hidden my keycard. Do not open the safe unless it's of absolute ^importance, for there could be rebel saboteurs about. Keep in mind that this may not be a drill, this could be for real this time.^" + UCMachine.numToStr(passcode)) + " is this week's passcode.");
  }
  else if (msgNum == 19) {
    textFile = ((("From: MGREENE^______________^*You will have to learn to write down the new passcodes.^I can't keep giving these out!^" + UCMachine.numToStr(passcode)) + " is this week's passcode.") + "^This is the last time, Philbert!^");
